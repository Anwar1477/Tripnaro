# URL of the Tripnaro Express API (server-side only; the browser goes through /api/v1 rewrites)
BACKEND_URL=http://localhost:5000

# Public URL of this site (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Facebook Messenger chat button (floating, bottom-right). Server-side only.
# Your Facebook Page username (the part after facebook.com/) or numeric Page ID, e.g. MESSENGER_PAGE=tripnaro
# Admin → Site settings → "Messenger live chat" overrides this value and can turn the button off.
# Leave empty (and the admin field empty) to hide the button.
MESSENGER_PAGE=
