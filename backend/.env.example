# ── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Public URL of the Next.js frontend (CORS origin + payment redirect target)
FRONTEND_URL=http://localhost:3000
# Public URL of this API (used for payment provider callbacks)
API_PUBLIC_URL=http://localhost:5000

# ── Database ─────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/tripnaro

# ── Auth ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=tripnaro_token
# Auth attempts (login/register/reset) per IP per 15 min. Raise only for automated test runs.
AUTH_RATE_LIMIT=30

# ── Seeder: initial admin account (used by `npm run seed`) ──
SEED_ADMIN_EMAIL=admin@tripnaro.com
SEED_ADMIN_PASSWORD=Admin@12345

# ── Email (leave SMTP_HOST empty to log emails to the console) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Tripnaro <no-reply@tripnaro.com>"

# ── Payments ─────────────────────────────────────────
# The demo adapter is always available and is clearly labelled in the UI.
# No real money is moved by the demo adapter.
PAYMENT_DEMO_ENABLED=true

# SSLCommerz (sandbox: https://developer.sslcommerz.com/registration/)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# bKash tokenized checkout
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

# Nagad merchant API
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PG_PUBLIC_KEY=
NAGAD_SANDBOX=true

# Stripe (optional, international cards)
STRIPE_SECRET_KEY=

# ── Flight inventory provider ────────────────────────
# "demo" serves Tripnaro's seeded sample schedules (labelled as demo inventory).
# "amadeus" requires AMADEUS_CLIENT_ID / AMADEUS_CLIENT_SECRET.
FLIGHT_PROVIDER=demo
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
